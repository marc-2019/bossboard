{
  "name": "@bossboard/mobile",
  "version": "0.5.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "test": "jest",
    "lint": "eslint .",
    "clean": "rm -rf node_modules .expo",
    "generate:assets": "node scripts/generate-assets.js",
    "export:web": "expo export --platform web",
    "e2e:install-maestro": "curl -Ls 'https://get.maestro.mobile.dev' | bash",
    "e2e:mobile": "maestro test .maestro/",
    "e2e:mobile:single": "maestro test",
    "eas-build-post-install": "node ./scripts/eas-patch-rniap-podspec.js && npm run build --workspace=@bossboard/shared --prefix ../..",
    "postinstall": "node ./scripts/eas-patch-rniap-podspec.js"
  },
  "dependencies": {
    "@bossboard/shared": "*",
    "@expo/metro-runtime": "~55.0.12",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@stripe/stripe-react-native": "0.63.0",
    "@testing-library/react-native": "^13.3.3",
    "expo": "~55.0.31",
    "expo-camera": "~55.0.23",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-device": "~55.0.21",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.17",
    "expo-location": "~55.1.14",
    "expo-network": "~55.0.18",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.24",
    "expo-splash-screen": "~55.0.25",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.33",
    "expo-web-browser": "~55.0.20",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-iap": "12.16.4",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-signature-canvas": "^4.7.2",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.22",
    "react-test-renderer": "19.2.0",
    "sharp": "^0.35.3",
    "typescript": "^5.7.3"
  }
}
