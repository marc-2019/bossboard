# BossBoard Environment Configuration
# Copy to .env and fill in your values

# =============================================================================
# APP BRANDING (configurable — no hardcoded product names in code)
# =============================================================================
APP_NAME=BossBoard
APP_DOMAIN=

# =============================================================================
# LOCAL DEMO LOGIN (gated — never writes without DEMO=1 and --demo-only)
# =============================================================================
# Dedicated local demo user only. Credentials are env-only — do not commit
# a real password. Email must be a reserved test address (@example.test).
# Writer no-ops on NODE_ENV=production and on a non-local DATABASE_URL
# (not localhost / 127.0.0.1 / bossboard-postgres). Attach rows only to
# this demo user_id. Do not point this at Railway.
# DEMO=0
# DEMO_USER_EMAIL=mike.tane@example.test
# DEMO_USER_PASSWORD=
# DEMO_USER_ID=

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_USER=bossboard
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=bossboard
DATABASE_URL=postgresql://bossboard:your-secure-password-here@localhost:29432/bossboard
# TLS for Postgres: production remote defaults to SSL on.
# DATABASE_SSL=true|false to force. DATABASE_SSL_REJECT_UNAUTHORIZED=true|false for cert verify.
# DATABASE_SSL=
# DATABASE_SSL_REJECT_UNAUTHORIZED=

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://localhost:29379

# =============================================================================
# API SERVER
# =============================================================================
PORT=29000
NODE_ENV=development

# CORS (comma-separated origins for mobile/web clients)
# CORS_ORIGINS=http://localhost:19006,http://localhost:8081,http://localhost:3000

# =============================================================================
# AUTHENTICATION (JWT)
# =============================================================================
JWT_SECRET=generate-32-char-random-string-here
JWT_REFRESH_SECRET=generate-another-32-char-random-string-here

# =============================================================================
# AI - ANTHROPIC
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# =============================================================================
# EMAIL (Resend — https://resend.com)
# =============================================================================
RESEND_API_KEY=re_your-resend-api-key-here
# Display name and from address used in outgoing emails
SMTP_FROM_NAME=BossBoard
SMTP_FROM_EMAIL=noreply@yourdomain.co.nz

# =============================================================================
# XERO INTEGRATION (Module 2 — future)
# =============================================================================
# XERO_CLIENT_ID=your-xero-client-id
# XERO_CLIENT_SECRET=your-xero-client-secret
# XERO_REDIRECT_URI=http://localhost:29000/auth/xero/callback

# =============================================================================
# STRIPE PAYMENTS
# =============================================================================
# Required when ANY Stripe-backed flow is in use (subscriptions OR invoice
# Payment Links). All can stay unset for fully-offline development — the
# webhook + payment-link endpoints fail-soft and the public invoice page
# falls back to bank-transfer-only display.

# Subscription billing (tradie / team tiers — Phase B):
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_ID_TRADIE=price_tradie_weekly
STRIPE_PRICE_ID_TEAM=price_team_weekly
STRIPE_RETURN_URL=http://localhost:19006
# Beta mode: when true (default), every user gets tradie-level features for free
# and /subscriptions/checkout returns a beta-mode message instead of a Stripe URL.
# Set to 'false' to enable real paid checkout. When 'false' in production,
# STRIPE_RETURN_URL must be a non-localhost URL or the API will refuse to start.
BETA_MODE=true

# Invoice Payment Links (Phase 1 — tradies' own customers paying invoices):
# Uses STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET above (no extra config). The
# publishable key is unused server-side; mobile/web clients that embed Stripe
# Elements in a later phase would consume STRIPE_PUBLISHABLE_KEY directly.
# STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# =============================================================================
# NATIVE IAP (App Store / Play) — dual-rail with Stripe on web
# =============================================================================
# Required before store submission with paid upgrades (BETA_MODE=false).
# Mobile never opens Stripe Checkout; see docs/product/native-iap-dual-rail.md
#
# IAP_APPLE_TRADIE_PRODUCT_ID=nz.instilligent.bossboard.tradie.weekly
# IAP_APPLE_TEAM_PRODUCT_ID=nz.instilligent.bossboard.team.weekly
# IAP_GOOGLE_TRADIE_PRODUCT_ID=bossboard_tradie_weekly
# IAP_GOOGLE_TEAM_PRODUCT_ID=bossboard_team_weekly
# IAP_GOOGLE_PACKAGE_NAME=nz.instilligent.bossboard
# IAP_APPLE_SHARED_SECRET=app-store-connect-shared-secret
# IAP_GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}   # or base64


# =============================================================================
# ANALYTICS — GA4 server-side (Measurement Protocol)
# =============================================================================
# Used to report off-web conversions the web gtag.js client can't observe:
# Stripe-hosted Checkout completion, mobile subscription flow, and webhook-
# driven tier upgrades fire a server-side `checkout_completed` event.
#
# GA4_MEASUREMENT_ID — the GA4 web data stream measurement ID. Defaults in code
# to the public landing-page tag (G-83NPHN0QP5); only override to point at a
# different stream.
# GA4_MEASUREMENT_ID=G-83NPHN0QP5
#
# GA4_MP_API_SECRET — generated in GA4 Admin → Data Streams → <web stream> →
# Measurement Protocol API secrets. When UNSET, server-side tracking is a clean
# no-op (the Stripe webhook is never affected). Leave blank until provisioned.
# GA4_MP_API_SECRET=your-ga4-measurement-protocol-api-secret

# =============================================================================
# TWILIO SMS (future)
# =============================================================================
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+64xxxxxxxxx

# =============================================================================
# FILE STORAGE
# =============================================================================
STORAGE_TYPE=local
STORAGE_PATH=./uploads
# For S3 (production):
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_S3_BUCKET=bossboard-documents
# AWS_REGION=ap-southeast-2

# =============================================================================
# MOBILE APP
# =============================================================================
API_URL=http://localhost:29000
# Production: https://api.yourdomain.co.nz

# =============================================================================
# SENTRY (optional — leave unset locally, set in Railway prod env)
# =============================================================================
# When SENTRY_DSN is empty, services/sentry.ts no-ops. No DSN required to
# build, test, or run locally. Mirrors the MOSS Sentry pattern.
# SENTRY_DSN=https://your-key@oXXXXXX.ingest.sentry.io/your-project
# SENTRY_RELEASE=  # optional override; defaults to RAILWAY_GIT_COMMIT_SHA
